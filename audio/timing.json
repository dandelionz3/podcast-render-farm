 "outro_start": 51.153,
 "lines": [
  {
   "speaker": "Nara",
   "text": "Jadi, AI lima tahun lagi bakal kayak gimana sih?",
   "start": 2.0,
   "end": 5.694,
   "start_frame": 48,
   "end_frame": 137,
   "shot": "twoshot"
  },
  {
   "speaker": "Bimo",
   "text": "Yang pasti, AI nggak lagi cuma alat. Dia jadi rekan kerja — nulis, ngoding, ngedit video, bareng kita.",
   "start": 7.694,
   "end": 14.896,
   "start_frame": 185,
   "end_frame": 358,
   "shot": "twoshot"
  },
  {
   "speaker": "Nara",
   "text": "Terus manusia ngapain dong?",
   "start": 16.897,
   "end": 18.573,
   "start_frame": 406,
   "end_frame": 446,
   "shot": "twoshot"
  },
  {
   "speaker": "Bimo",
   "text": "Manusia yang pegang arahnya. Ide, rasa, keputusan — itu tetap punya kita. AI yang eksekusi.",
   "start": 20.573,
   "end": 27.889,
   "start_frame": 494,
   "end_frame": 669,
   "shot": "twoshot"
  },
  {
   "speaker": "Nara",
   "text": "Takut nggak sih, AI gantiin semua kerjaan?",
   "start": 29.89,
   "end": 33.3,
   "start_frame": 717,
   "end_frame": 799,
   "shot": "twoshot"
  },
  {
   "speaker": "Bimo",
   "text": "Yang digantiin itu kerjaan yang berulang. Yang butuh rasa dan akal sehat — tetap manusia.",
   "start": 35.3,
   "end": 41.206,
   "start_frame": 847,
   "end_frame": 989,
   "shot": "twoshot"
  },
  {
   "speaker": "Nara",
   "text": "Jadi masa depan AI itu...",
   "start": 43.206,
   "end": 44.715,
   "start_frame": 1037,
   "end_frame": 1073,
   "shot": "twoshot"
  },
  {
   "speaker": "Bimo",
   "text": "Bukan manusia lawan AI. Tapi manusia plus AI.",
   "start": 47.215,
   "end": 51.153,
   "start_frame": 1133,
   "end_frame": 1228,
   "shot": "twoshot"
  }
 ],
